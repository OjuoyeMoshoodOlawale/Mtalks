# ══════════════════════════════════════════════════════
#  Muhsinah Academy — Server Environment Variables
#  Copy this file: cp .env.example .env
#  Fill in ALL values before starting the server
# ══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name

# ── JWT ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_BYTE_HEX
JWT_ACCESS_EXPIRES=15m 
JWT_REFRESH_EXPIRES=7d

# ── cPanel SMTP ───────────────────────────────────────
SMTP_HOST=mail.themuhsinahacademy.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@themuhsinahacademy.com
SMTP_PASS=your_cpanel_email_password

# ── Gmail fallback (optional) ────────────────────────
GMAIL_USER=themuhsinahacademy@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Paystack ─────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ── Google Drive (optional) ──────────────────────────
GOOGLE_API_KEY=your_google_api_key
