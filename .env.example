# =====================================================
# Muhsinah Academy Platform — Environment Variables
# Copy this file to .env and fill in your values
# Never commit the actual .env file to git
# =====================================================

# ── App ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=mtalks_db

# ── JWT ──
# REQUIRED in production (server refuses to start without them)
# Generate with: openssl rand -hex 64
JWT_SECRET=muhsinah_access_secret_change_in_production
JWT_REFRESH_SECRET=muhsinah_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Email (Gmail — FREE) ──
# Step 1: Enable 2-Step Verification on your Gmail account
# Step 2: Go to Google Account → Security → App Passwords → Generate
# Step 3: Paste the 16-character app password below (no spaces)
GMAIL_USER=madeenahsanni@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_FROM="Muhsinah Academy <madeenahsanni@gmail.com>"

# ── Paystack (free to use — charged per transaction) ──
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ── Client (Vite prefix VITE_ required) ──
VITE_API_URL=http://localhost:5000/api
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
VITE_SITE_URL=https://www.muhsinahacademy.com

# ── Calendly (FREE tier — just paste your Calendly URL) ──
# Stored in the settings table, editable from Admin → Settings
# Free plan allows unlimited 1-on-1 meetings and 1 event type
VITE_CALENDLY_URL=https://calendly.com/madeenahsanni

# ── Crisp Chat (FREE tier) ──
# Sign up at crisp.chat → Dashboard → Website Settings → Website ID
VITE_CRISP_WEBSITE_ID=your_crisp_website_id

# ── NOTE: No Google Drive API key needed ──
# Videos & gallery images use plain share links only.
# Drive files: share as "Anyone with link → Viewer" (disable download for videos).
# YouTube videos: upload as Unlisted.

# ── Google Drive Folder Import (optional) ─────────────────────────────────────
# Required ONLY if you want to import an entire Drive folder into the gallery.
# Steps:
#   1. Go to https://console.cloud.google.com
#   2. Create a project → APIs & Services → Enable "Google Drive API"
#   3. Credentials → Create API Key (restrict to "Google Drive API" for safety)
#   4. Paste the key below
#   5. Share your Drive folder as "Anyone with the link → Viewer"
# This key is read-only — it cannot modify or delete any Drive files.
GOOGLE_API_KEY=your_google_api_key_here

# ── Port forwarding / staging access (optional) ─────────────────────────────
# If you share the server via ngrok, Cloudflare Tunnel, or a LAN IP,
# add those origins here (comma-separated) to allow browser requests.
# In development mode, localhost/LAN/ngrok origins are allowed automatically.
# In production, list every frontend URL that should be able to call the API.
# EXTRA_ORIGINS=https://abc123.ngrok-free.app,http://192.168.1.50:5173
