# ==========================================
# MTalks Platform — Environment Variables
# ==========================================

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=mtalks_db

# JWT (generate RS256 key pair: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY=your_rsa_private_key_here
JWT_PUBLIC_KEY=your_rsa_public_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Email (Nodemailer — Brevo SMTP recommended)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASS=your_brevo_smtp_password
MAIL_FROM=noreply@muhsinahacademy.com
ADMIN_EMAIL=madeenahsanni@gmail.com

# Google Drive (for video embed validation)
GOOGLE_API_KEY=your_google_api_key_here

# Client (Vite — prefix with VITE_)
VITE_API_URL=http://localhost:5000/api
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
VITE_CRISP_WEBSITE_ID=your_crisp_id_here
VITE_CALENDLY_URL=https://calendly.com/madeenahsanni
