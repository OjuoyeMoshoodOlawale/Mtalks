# ── Muhsinah Academy — Client environment variables ──────────────────────────
#
# Copy this file to client/.env.local and fill in your values.
# VITE_* variables are injected at build time by Vite.
# Never commit .env.local to git.
#

# Paystack PUBLIC key (pk_test_... or pk_live_...)
# Get from: https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base URL — leave empty for local dev (Vite proxy handles /api → :5000)
# Set this to your live API URL when deploying (e.g. https://api.muhsinahacademy.com/api)
VITE_API_URL=
